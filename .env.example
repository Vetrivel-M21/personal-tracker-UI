# Copy to .env for local dev. Vite only exposes vars prefixed VITE_ to
# client code, and bakes them in at BUILD time (not read at runtime) - so
# `npm run build` must be run with this set, not just the server it deploys to.

# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID
# (Application type: Web application). Only the Client ID is needed here -
# never put a Client Secret in frontend code.
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
